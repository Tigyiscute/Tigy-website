@bot.command(name="delete-tickets")
async def delete_tickets(ctx):
    if not is_authorized(ctx):
        await deny(ctx)
        return

    channels = [ch for ch in ctx.guild.text_channels if is_ticket_channel(ch)]
    if not channels:
        await ctx.send("No ticket channels found.")
        return

    channels.sort(key=lambda ch: extract_number(ch.name))
    await ctx.send(f"Deleting {len(channels)} ticket channel(s)...")

    deleted = 0
    for channel in channels:
        try:
            await channel.delete(reason="!delete-tickets command")
            deleted += 1
            await asyncio.sleep(0.5)
        except discord.Forbidden:
            await ctx.send(f"No permission to delete #{channel.name}.")
        except discord.NotFound:
            pass

    try:
        await ctx.send(f"Done. Deleted {deleted} ticket channel(s).")
    except discord.NotFound:
        pass

