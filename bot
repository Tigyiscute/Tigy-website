@bot.command(name="send")
async def send_to_tickets(ctx):
    if not is_authorized(ctx):
        await deny(ctx)
        return

    ticket_channels = [ch for ch in ctx.guild.text_channels if is_ticket_channel(ch)]
    if not ticket_channels:
        await ctx.send("No ticket channels found.")
        return

    sent = 0
    skipped = 0
    for channel in ticket_channels:
        if await already_sent(channel):
            skipped += 1
            continue
        await send_ticket_message(channel)
        sent += 1

    await ctx.send(f"Sent to {sent} ticket channel(s). Skipped {skipped} (already sent).")

